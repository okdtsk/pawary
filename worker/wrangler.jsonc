{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pawary",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pawary",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pawary-photos" }],
  "ratelimits": [
    { "name": "RL_5", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_10", "namespace_id": "1010", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_30", "namespace_id": "1030", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "development" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CareteamNotifier"] },
    { "tag": "v2", "deleted_classes": ["CareteamNotifier"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true } },
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "production": {
      "name": "pawary",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "production" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["CareteamNotifier"] },
        { "tag": "v2", "deleted_classes": ["CareteamNotifier"] }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pawary",
          "database_id": "d37c2af2-a640-4d54-9533-3721a05143cd",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pawary-photos" }],
      "ratelimits": [
        { "name": "RL_5", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_10", "namespace_id": "1010", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_30", "namespace_id": "1030", "simple": { "limit": 30, "period": 60 } }
      ],
      "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true } },
      "assets": {
        "directory": "../app/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    },
    "preview": {
      "name": "pawary-preview",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "preview" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["CareteamNotifier"] },
        { "tag": "v2", "deleted_classes": ["CareteamNotifier"] }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pawary-preview",
          "database_id": "8d52d15f-7234-4d76-879d-134c6db080ff",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pawary-photos-preview" }],
      "ratelimits": [
        { "name": "RL_5", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_10", "namespace_id": "1010", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_30", "namespace_id": "1030", "simple": { "limit": 30, "period": 60 } }
      ],
      "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true } },
      "assets": {
        "directory": "../app/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    }
  }
}
